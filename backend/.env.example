# Copy to backend/.env and fill in. Every value below is the application default unless noted.
# Never commit backend/.env (it is git-ignored).

# --- service
ENVIRONMENT=development                # development | test | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                     # json (production) | console (local)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
EXPOSE_DOCS=true                       # /docs, /redoc, /openapi.json

# --- database (PostgreSQL 14+ with PostGIS 3+; e.g. Supabase or docker-compose "db")
# Supabase: Project -> Connect -> "Session pooler" (IPv4). URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/geomeasure
DB_SCHEMA=geomeasure                   # dedicated schema (not exposed by Supabase's auto REST API)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- object storage
STORAGE_BACKEND=local                  # local | s3
STORAGE_LOCAL_ROOT=var/storage
# S3_BUCKET=my-geomeasure-uploads      # required when STORAGE_BACKEND=s3
# S3_PREFIX=prod
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=                     # only for S3-compatible services other than AWS
# AWS credentials come from the standard chain (IAM role / AWS_* env vars), never from this file.

# --- upload limits (untrusted input)
MAX_UPLOAD_BYTES=104857600             # 100 MiB
MAX_ZIP_ENTRIES=200
MAX_ZIP_UNCOMPRESSED_BYTES=1073741824  # 1 GiB
MAX_ZIP_COMPRESSION_RATIO=1000

# --- processing
MAX_FEATURES_PER_FILE=1000000
MAX_VERTICES_PER_FEATURE=1000000
PROCESSING_BATCH_SIZE=5000
MEASUREMENT_STRATEGY=local_equal_area  # local_equal_area | utm
DISTORTION_WARNING_THRESHOLD=0.001     # flag features whose projected/geodesic difference exceeds 0.1 %

# --- job queue / worker
EMBEDDED_WORKER=true                   # run a worker thread inside the API (dev); production: separate workers
WORKER_POLL_INTERVAL_S=1.0
WORKER_LEASE_S=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_S=10
UPLOAD_WAIT_MAX_S=30                   # cap for the "Prefer: wait=N" request header

# --- read API
PAGE_SIZE_DEFAULT=100
PAGE_SIZE_MAX=500
FEATURE_PAGE_SIZE_MAX=200
TILE_MAX_FEATURES=20000

# --- tests only: integration tests create & drop an isolated schema in this database
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/geomeasure
